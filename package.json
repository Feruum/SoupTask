{
  "name": "soup-training-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint --deny-warnings src e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:check": "node scripts/check-manifest.mjs",
    "test:negative": "node scripts/run-negative-controls.mjs",
    "perf": "node scripts/performance.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.70.0",
    "motion": "14.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.5",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
